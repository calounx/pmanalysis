#!/bin/bash
##############################################
# Prometheus Exporter for Health Check
# Managed by Ansible - DO NOT EDIT MANUALLY
##############################################

set -euo pipefail

TEXTFILE_DIR=/var/lib/node_exporter/textfile_collector
TEMP_FILE="${TEXTFILE_DIR}/health.prom.$$"
FINAL_FILE="${TEXTFILE_DIR}/health.prom"

# Run health check and get JSON
JSON=$({{ health_check_install_dir }}/health-check.sh --json)

# Extract metrics
SCORE=$(echo "$JSON" | jq -r '.score')
HOSTNAME=$(hostname)

# Generate Prometheus metrics
cat > "${TEMP_FILE}" <<EOF
# HELP system_health_score Overall system health (0-100)
# TYPE system_health_score gauge
system_health_score{host="$HOSTNAME"} $SCORE

# HELP system_cpu_load_1min CPU load average 1 minute
# TYPE system_cpu_load_1min gauge
system_cpu_load_1min{host="$HOSTNAME"} $(echo "$JSON" | jq -r '.metrics.cpu.load_1min')

# HELP system_memory_usage_percent Memory usage percentage
# TYPE system_memory_usage_percent gauge
system_memory_usage_percent{host="$HOSTNAME"} $(echo "$JSON" | jq -r '.metrics.memory.usage_percent')

# HELP system_disk_usage_percent Disk usage percentage
# TYPE system_disk_usage_percent gauge
$(echo "$JSON" | jq -r '.metrics.disk.filesystems[] | "system_disk_usage_percent{host=\"'$HOSTNAME'\",mount=\"\(.mount)\"} \(.usage_percent)"')
EOF

# Atomic update
mv "${TEMP_FILE}" "${FINAL_FILE}"
